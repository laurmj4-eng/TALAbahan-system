#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# Local: development | Render: production (set in dashboard)
CI_ENVIRONMENT=production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Leave empty on Render — App.php auto-detects from HTTP_HOST + X-Forwarded-Proto
app.baseURL=
app.indexPage=
# Render dashboard: set to true
app.forceGlobalSecureRequests=false

#--------------------------------------------------------------------
# DATABASE (Render MySQL — set in Dashboard, never commit values)
#--------------------------------------------------------------------
# Use CI4 dotted keys OR aliases DB_HOSTNAME, DB_NAME, DB_USERNAME, DB_PASSWORD, DB_PORT
database.default.hostname=
database.default.database=
database.default.username=
database.default.password=
database.default.DBDriver=MySQLi
database.default.DBPrefix=
database.default.port=3306
database.default.encrypt=false

#--------------------------------------------------------------------
# INERTIA (bump on each deploy)
#--------------------------------------------------------------------
INERTIA_VERSION=1

#--------------------------------------------------------------------
# SECURITY — Render secrets only (php spark key:generate --show)
#--------------------------------------------------------------------
encryption.key=
# v2 "I'm not a robot" key pair from https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Set to true to skip widget + server verification
RECAPTCHA_DISABLED=false
# Set to false only if siteverify fails with SSL errors on XAMPP (then restart Apache)
RECAPTCHA_SSL_VERIFY=true

#--------------------------------------------------------------------
# FIREBASE — Render secrets only
#--------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

#--------------------------------------------------------------------
# NODE.JS DATABASE CONFIG
#--------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=mj_chatbot
DB_PORT=3306
DB_SSL=false

#--------------------------------------------------------------------
# API KEYS
#--------------------------------------------------------------------
OPENROUTER_API_KEY=
CORS_ORIGIN=http://localhost:8080

#--------------------------------------------------------------------
# DEFAULT USER CREDENTIALS (for seeding / demo only)
#--------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=changeme

#--------------------------------------------------------------------
# PHP BRIDGE (for chatbot sales data)
#--------------------------------------------------------------------
PHP_BRIDGE_URL=
SECRET_TOKEN=

#--------------------------------------------------------------------
# EMAIL CONFIGURATION
#--------------------------------------------------------------------
email.fromEmail=no-reply@example.com
email.fromName="TALAbahan System"
email.protocol=mail
email.SMTPHost=
email.SMTPUser=
email.SMTPPass=
email.SMTPPort=587
email.SMTPCrypto=tls

#--------------------------------------------------------------------
# ORDER LIFECYCLE SETTINGS
#--------------------------------------------------------------------
orderLifecycle.paymentTimeoutMinutes=30
orderLifecycle.autoCompleteDays=3
orderLifecycle.refundWindowDays=7

#--------------------------------------------------------------------
# ADMIN NOTIFICATION EMAIL
#--------------------------------------------------------------------
admin.notificationEmail=admin@example.com

#--------------------------------------------------------------------
# RENDER DASHBOARD CHECKLIST (copy keys, paste values in Environment)
#--------------------------------------------------------------------
# Required:
#   CI_ENVIRONMENT=production
#   database.default.hostname, database.default.database,
#   database.default.username, database.default.password, database.default.port
#   encryption.key          (from: php spark key:generate --show)
#   RECAPTCHA_SITE_KEY, RECAPTCHA_SECRET_KEY
#   INERTIA_VERSION         (e.g. git commit SHA)
# Recommended:
#   app.forceGlobalSecureRequests=true
#   FIREBASE_* (all keys above)
#   CORS_ORIGIN=https://your-service.onrender.com
# Custom domain only:
#   app.baseURL=https://your-domain.com/
# reCAPTCHA Admin: add your-service.onrender.com to allowed domains
# Local dev: add localhost and 127.0.0.1 to the v2 key domains (use the same URL host you browse with)
# Console noise (api2/pat 401, private-token) is a known Google PAT quirk and is usually harmless

#--------------------------------------------------------------------
# CACHE / SESSION / LOGGING
#--------------------------------------------------------------------
cache.default=file
session.driver=FileHandler
session.cookieSameSite=Strict
log.threshold=1

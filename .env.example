#--------------------------------------------------------------------
# ENVIRONMENT - CONFIGURATION
#--------------------------------------------------------------------
# Set to 'production' for live server, 'development' for local
CI_ENVIRONMENT=production

#--------------------------------------------------------------------
# APP - CONFIGURATION
#--------------------------------------------------------------------
# Render and most platforms detect the domain automatically
# Leave empty or use env('APP_BASE_URL') to auto-detect
app.baseURL=''
app.indexPage=''
app.forceGlobalSecureRequests=false

#--------------------------------------------------------------------
# DATABASE - RENDER/PRODUCTION
#--------------------------------------------------------------------
# ⚠️ IMPORTANT: DO NOT commit database credentials here!
# Set these as environment variables in your Render dashboard:
# https://dashboard.render.com/ > Your Service > Environment Variables
#
# For Render MySQL database:
database.default.hostname=${DB_HOSTNAME}
database.default.database=${DB_NAME}
database.default.username=${DB_USERNAME}
database.default.password=${DB_PASSWORD}
database.default.DBDriver=MySQLi
database.default.DBPrefix=
database.default.port=${DB_PORT:3306}
database.default.encrypt=true

#--------------------------------------------------------------------
# CACHE CONFIGURATION
#--------------------------------------------------------------------
# Recommended for production: use Redis if available on Render
# cache.default=redis
cache.default=file

#--------------------------------------------------------------------
# INERTIA.JS ASSET VERSIONING
#--------------------------------------------------------------------
# Set a cache-busting version. Change this on each deployment.
# Example: hash git commit SHA or deployment timestamp
INERTIA_VERSION=1

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------
# Set in Render environment secrets, NOT here
ENCRYPTION_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
OPENROUTER_API_KEY=

#--------------------------------------------------------------------
# FIREBASE CONFIGURATION
#--------------------------------------------------------------------
# Set in Render environment secrets, NOT here
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

#--------------------------------------------------------------------
# CORS AND CROSS-ORIGIN
#--------------------------------------------------------------------
# For production, set specific allowed origins
CORS_ORIGIN=${APP_BASE_URL}

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------
# Production should use 'error' level
log.threshold=1

#--------------------------------------------------------------------
# SESSION CONFIGURATION
#--------------------------------------------------------------------
# Recommended: use database sessions in production
# session.driver=DatabaseHandler
session.driver=FileHandler
session.cookieSameSite=Strict

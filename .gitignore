# CodeIgniter 4 Files
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
!/writable/.gitkeep
!/writable/*/index.html
!/writable/*/.gitkeep
/vendor/
/.env
/public/uploads/*
!/public/uploads/.gitkeep

# Node.js Files
/node_modules/
npm-debug.log
yarn-error.log

# Build / debug artifacts
/dist/
/public/dist/
/public/build/
/public/hot
test.php
test_orders.php
composer.phar

# Composer cache (never commit)
.composer/cache/

# Firebase deploy cache
.firebase/

# Duplicate agent skills (keep .agents/skills only)
.trae/

# Accidental path commits
%USERPROFILE%/

# IDE Files
.vscode/
.idea/
*.swp
*.swo

# OS Files
.DS_Store
Thumbs.db

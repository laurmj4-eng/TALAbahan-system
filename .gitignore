# CodeIgniter 4 Files
/writable/cache/*
/writable/debugbar/*
/writable/logs/*
/writable/session/*
!/writable/.gitkeep
!/writable/*/index.html
!/writable/*/.gitkeep
/vendor/
/.env
/public/uploads/*
!/public/uploads/.gitkeep

# Node.js Files
/node_modules/
npm-debug.log
yarn-error.log

# Build / debug artifacts
/dist/
/public/dist/

# Vite build output — generated by `npm run build`, never committed.
# Built fresh on every deploy (see Dockerfile* frontend-builder stages / build.sh).
/public/build/

/public/hot
test.php
test_orders.php
composer.phar

# Composer cache (never commit)
.composer/cache/

# Firebase deploy cache
.firebase/

# Duplicate agent skills (keep .agents/skills only)
.trae/

# Accidental path commits
%USERPROFILE%/

# IDE Files
.vscode/
.idea/
*.swp
*.swo

# Android Shell build artifacts
android-shell/.gradle/
android-shell/app/build/
android-shell/app/release/
android-shell/app/google-services.json
*.apk
*.aab

# Firebase Admin SDK key (sensitive — never commit)
/writable/conf/*
!/writable/conf/.gitkeep
!/writable/conf/index.html

# OS Files
.DS_Store
Thumbs.db
